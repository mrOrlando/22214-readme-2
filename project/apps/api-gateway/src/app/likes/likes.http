@hostname=localhost
@port=4000
@host={{hostname}}:{{port}}
@postId=ab04593b-da99-4fe3-8b4b-e06d82e2efdd

# Log in
# @name login
POST http://{{host}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "keks@readme.local",
  "password": "123456"
}

###

# Like a post
POST http://{{host}}/api/posts/{{postId}}/likes HTTP/1.1
Authorization: Bearer {{login.response.body.accessToken}}

###

# Like the same post again (409)
POST http://{{host}}/api/posts/{{postId}}/likes HTTP/1.1
Authorization: Bearer {{login.response.body.accessToken}}

###

# The counter of likes is returned with the post
GET http://{{host}}/api/posts/{{postId}} HTTP/1.1

###

# Take the like back
DELETE http://{{host}}/api/posts/{{postId}}/likes HTTP/1.1
Authorization: Bearer {{login.response.body.accessToken}}
