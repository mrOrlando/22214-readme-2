PORT=4000

# Addresses of the services, the gateway is the only client of them
USER_SERVICE_URL=http://localhost:3333
BLOG_SERVICE_URL=http://localhost:3000
FILE_SERVER_URL=http://localhost:3335
NOTIFICATION_SERVICE_URL=http://localhost:3334

# Must be the same as in the user service: the gateway checks access tokens itself
JWT_ACCESS_TOKEN_SECRET=

# Addresses of the frontend allowed by CORS, comma separated
CORS_ORIGINS=http://localhost:5173
