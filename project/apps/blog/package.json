{
  "name": "@project/blog",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "blog",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "blog:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "blog:build:development"
          },
          "production": {
            "buildTarget": "blog:build:production"
          }
        }
      },
      "db:lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/shared/blog/models",
          "command": "npx prisma validate --schema prisma/schema.prisma"
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/shared/blog/models",
          "command": "npx prisma migrate dev --schema prisma/schema.prisma"
        }
      },
      "db:reset": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/shared/blog/models",
          "command": "npx prisma migrate reset --schema prisma/schema.prisma --force"
        }
      },
      "db:generate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/shared/blog/models",
          "command": "npx prisma generate --schema prisma/schema.prisma"
        }
      },
      "db:seed": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/shared/blog/models",
          "command": "npx tsx prisma/seed.ts"
        }
      }
    }
  }
}
