@hostname=localhost
@port=3000
@host={{hostname}}:{{port}}

# Get tags
GET http://{{host}}/api/tags HTTP/1.1

###

# Get tag by id
@tagId=efd775e2-df55-4e0e-a308-58249f5ea202

GET http://{{host}}/api/tags/{{tagId}} HTTP/1.1

###

# Create tag
# @name createTag
POST http://{{host}}/api/tags HTTP/1.1
Content-Type: application/json

{
  "title": "Travel"
}

###

# Delete tag by id

DELETE http://{{host}}/api/tags/{{createTag.response.body.id}} HTTP/1.1

###

# Update tag by id
PATCH http://{{host}}/api/tags/{{createTag.response.body.id}} HTTP/1.1
Content-Type: application/json

{
  "title": "Journey"
}
