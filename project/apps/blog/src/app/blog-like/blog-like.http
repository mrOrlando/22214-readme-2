@hostname=localhost
@port=3000
@host={{hostname}}:{{port}}
@postId=ab04593b-da99-4fe3-8b4b-e06d82e2efdd
@userId=6581762309c030b503e30512

# Like post
POST http://{{host}}/api/posts/{{postId}}/likes HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}"
}

###

# Like the same post again (409)
POST http://{{host}}/api/posts/{{postId}}/likes HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}"
}

###

# The likes counter is returned with the post
GET http://{{host}}/api/posts/{{postId}} HTTP/1.1

###

# Remove like
DELETE http://{{host}}/api/posts/{{postId}}/likes?userId={{userId}} HTTP/1.1
