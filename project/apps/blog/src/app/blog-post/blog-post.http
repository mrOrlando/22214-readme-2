@hostname=localhost
@port=3000
@host={{hostname}}:{{port}}
@postId=ab04593b-da99-4fe3-8b4b-e06d82e2efdd
@userId=658170cbb954e9f5b905ccf4
@otherUserId=6581762309c030b503e30512

# Get published posts (25 per page, sorted by publication date)
GET http://{{host}}/api/posts HTTP/1.1

###

# Get the second page, 2 posts per page
GET http://{{host}}/api/posts?limit=2&page=2 HTTP/1.1

###

# Sort by likes
GET http://{{host}}/api/posts?sortBy=likes HTTP/1.1

###

# Sort by comments
GET http://{{host}}/api/posts?sortBy=comments HTTP/1.1

###

# Filter by author, type and tag
GET http://{{host}}/api/posts?userId={{userId}}&type=text&tag=books HTTP/1.1

###

# Invalid query parameters (400)
GET http://{{host}}/api/posts?limit=100&page=0&sortBy=rating HTTP/1.1

###

# Search published posts by title
GET http://{{host}}/api/posts/search?title=javascript nestjs HTTP/1.1

###

# Get drafts of the user
GET http://{{host}}/api/posts/drafts?userId={{userId}} HTTP/1.1

###

# Get post by id
GET http://{{host}}/api/posts/{{postId}} HTTP/1.1

###

# Get post by invalid id (400)
GET http://{{host}}/api/posts/123 HTTP/1.1

###

# Create text post
# @name createPost
POST http://{{host}}/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "text",
  "title": "Solaris: a novel by Stanisław Lem",
  "announcement": "A thought-provoking exploration of human consciousness and alien intelligence.",
  "text": "Recently finished reading 'Solaris'. The ocean planet that reads the minds of the crew is one of the most unusual images in science fiction.",
  "userId": "{{userId}}",
  "tags": ["books", "SciFi", "scifi"]
}

###

# Create video post
POST http://{{host}}/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "video",
  "title": "NestJS crash course for beginners",
  "videoUrl": "https://www.youtube.com/watch?v=GHTA143_b-s",
  "userId": "{{userId}}",
  "tags": ["computers"]
}

###

# Create quote post
POST http://{{host}}/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "quote",
  "quoteText": "Simplicity is prerequisite for reliability.",
  "quoteAuthor": "Edsger Dijkstra",
  "userId": "{{userId}}"
}

###

# Create photo post
POST http://{{host}}/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "photo",
  "photo": "/uploads/mountains.jpg",
  "userId": "{{userId}}",
  "tags": ["travel"]
}

###

# Create link post
POST http://{{host}}/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "link",
  "linkUrl": "https://docs.nestjs.com",
  "linkDescription": "NestJS documentation",
  "userId": "{{userId}}"
}

###

# Create post with invalid data (400)
POST http://{{host}}/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "text",
  "title": "Too short",
  "userId": "not-an-id",
  "tags": ["two words", "1digit"]
}

###

# Update own post
PATCH http://{{host}}/api/posts/{{createPost.response.body.id}} HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}",
  "title": "Solaris: a novel by Stanisław Lem (updated)",
  "tags": ["classic"]
}

###

# Update a post of another user (403)
PATCH http://{{host}}/api/posts/{{createPost.response.body.id}} HTTP/1.1
Content-Type: application/json

{
  "userId": "{{otherUserId}}",
  "title": "This title will not be saved at all"
}

###

# Move post to drafts
PATCH http://{{host}}/api/posts/{{createPost.response.body.id}} HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}",
  "status": "draft"
}

###

# Publish post and change its publication date
PATCH http://{{host}}/api/posts/{{createPost.response.body.id}} HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}",
  "status": "published",
  "publishedAt": "2026-10-01T09:00:00.000Z"
}

###

# Repost post (a post can be reposted by a user only once)
POST http://{{host}}/api/posts/{{createPost.response.body.id}}/repost HTTP/1.1
Content-Type: application/json

{
  "userId": "{{otherUserId}}"
}

###

# Delete a post of another user (403)
DELETE http://{{host}}/api/posts/{{createPost.response.body.id}}?userId={{otherUserId}} HTTP/1.1

###

# Delete own post
DELETE http://{{host}}/api/posts/{{createPost.response.body.id}}?userId={{userId}} HTTP/1.1
