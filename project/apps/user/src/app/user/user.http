@hostname=localhost
@port=3000
@host={{hostname}}:{{port}}

# Create a new user
# @name register
POST http://{{host}}/api/users/register HTTP/1.1
Content-Type: application/json

{
  "name": "Alex",
  "email": "alex@example.com",
  "password": "12345678"
}

###

# Get users
GET http://{{host}}/api/users HTTP/1.1
